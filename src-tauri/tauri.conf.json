{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Switch AI",
  "mainBinaryName": "ai-work-assistant",
  "identifier": "com.aiwork.assistant",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Switch AI",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "resizable": true,
        "center": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'self'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.ico"],
    "shortDescription": "Switch AI 多账号签到与管理助手",
    "longDescription": "整合多账号签到、登录态切换、设备隔离与账号分组的 Windows 桌面端工具，支持 Trae / WorkBuddy（含国际版）/ CodeBuddy / 豆包 / Qoder 等应用扩展。",
    "publisher": "Switch AI",
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["SimpChinese"],
        "installerHooks": "../build-assets/installer-hooks.nsh",
        "template": "../build-assets/installer.nsi"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": "https?://\\S+"
    }
  }
}
